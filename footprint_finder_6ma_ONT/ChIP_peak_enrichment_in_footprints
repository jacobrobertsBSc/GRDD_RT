extraCols_narrowPeak <- c(signalValue = "numeric", pValue = "numeric",
                          qValue = "numeric", peak = "numeric", sample = "character")

for(tf in names(tf_files_PP2_most_likePP4)) {
tf_gr <- import(tf_files_PP2_most_likePP4[[tf]], format = "BED", extraCols = extraCols_narrowPeak)

#https://web.mit.edu/~r/current/arch/i386_linux26/lib/R/library/IRanges/html/findOverlaps-methods.html
mcols(fire_gr)[[tf]] <- as.integer(overlapsAny(fire_gr, tf_gr))
}

#To store the output table for the fisher.test scores 
tf_results <- data.frame(
  TF = character(),
  Odds_ratio = numeric(),
  P_value = numeric(),
  stringsAsFactors = FALSE
)

for (tf in names(tf_files_PP2_most_likePP4)) {
#create a contingency table for the TF
  fisher_table <- table(
    fire_gr$footprint_present,
    mcols(fire_gr)[[tf]]
  )

  test <- fisher.test(fisher_table)
#Adding a new row to the data.frame with the data from the temporary data frame for each iteration 
  tf_results <- rbind(tf_results,
    data.frame(
      TF = tf,
      Odds_ratio = unname(test$estimate),
      P_value = test$p.value
    )
  )
}

tf_results

